NODE_ENV=production
PORT=8787
ALLOWED_EXTENSION_IDS=
PUBLISHER_NAME=
SUPPORT_EMAIL=
SUPPORT_URL=
# Optional: keep this key only on the server, never in the extension.
SERPAPI_KEY=
DAILY_SEARCH_LIMIT=100
SEARCHES_PER_MINUTE=12
MAX_CONCURRENT_SEARCHES=4
# Set only to the number of verified reverse proxies in front of the app.
TRUST_PROXY_HOPS=0
